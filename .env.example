# Read by docker-compose.yml. Copy to .env (`npm run setup` does it for you and generates JWT_ACCESS_SECRET).
# Host-mode dev (npm run dev) reads app settings from backend/.env and frontend/.env.local instead.

# ── Database (Postgres in Docker, published on 127.0.0.1:POSTGRES_PORT) ──
POSTGRES_USER=ielts
POSTGRES_PASSWORD=ielts_dev_password
POSTGRES_DB=ielts
POSTGRES_PORT=5434
LT_PORT=8010

# ── Full Docker mode only: docker compose --profile app up -d --build ──
API_PORT=41000
WEB_PORT=31000
# Only if you open the app at another address (default http://localhost:${WEB_PORT}; 127.0.0.1 also works):
# WEB_ORIGIN=http://localhost:31000
# Leave empty: the API container generates a random secret once and keeps it in data/.jwt_secret.
# (`npm run setup` fills it in for you.)
JWT_ACCESS_SECRET=
# Accounts created on first start (passwords >= 10 characters). Change them.
SEED_ADMIN_EMAIL=admin@ielts.local
SEED_ADMIN_PASSWORD=123456789
SEED_ADMIN_NAME=Quản trị viên
SEED_STUDENT_EMAIL=dat@ielts.local
SEED_STUDENT_PASSWORD=123456789
SEED_STUDENT_NAME=Đạt

# ── Cloudflare Tunnel (optional): docker compose --profile app --profile tunnel up -d ──
# Token from Cloudflare Zero Trust → Networks → Tunnels (secret, keep it only in .env).
# Public hostname → Service: http://frontend:3000
CLOUDFLARE_TUNNEL_TOKEN=
# Public address users open, e.g. https://ielts.example.com (added to the API's allowed origins).
PUBLIC_ORIGIN=
