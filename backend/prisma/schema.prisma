// Prisma ORM 7.10.1 — connection URL lives in prisma.config.ts.
// Phase 1 schema. Later phases add models with additive migrations:
//   [P2] OcrJob, OcrJobSource, OcrPage · [P5] WritingSubmission, WritingEvaluation, SpeakingRecording, SpeakingEvaluation
//   [P6] Vocabulary, VocabularyReview, StudyStat, UserTestMark, DictionaryCache
// All enums (including values used only by later phases) are created now to avoid ALTER TYPE mid-project.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────── ENUMS ─────────

enum Role {
  ADMIN
  STUDENT
}

/// Display/filter priority is NOT the declaration order — use SOURCE_PRIORITY in src/shared.
enum TestSource {
  CAM
  VOL
  PRE_IELTS
  CUSTOM // self-written dummy/seed tests
}

enum TestType {
  ACADEMIC
  GENERAL
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED // superseded by a newer published version; still referenced by old attempts
}

enum Skill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum ParagraphKind {
  BODY
  HEADING
  SUBHEADING
  FIGURE
  FOOTNOTE
}

enum QuestionType {
  MULTIPLE_CHOICE_SINGLE
  MULTIPLE_CHOICE_MULTI
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING_HEADINGS
  MATCHING_INFORMATION
  MATCHING_FEATURES
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  NOTE_TABLE_FLOWCHART_COMPLETION
  SHORT_ANSWER
  MAP_DIAGRAM_LABELLING
}

enum WritingTaskKind {
  ACADEMIC_REPORT // AC Task 1
  GENERAL_LETTER // GT Task 1
  ESSAY // Task 2
}

enum AttemptMode {
  EXAM
  PRACTICE
}

/// QUESTION_TYPE / QUESTION_IDS are PRACTICE-only; QUESTION_IDS = "retry wrong answers".
enum AttemptScope {
  SECTION
  PART
  QUESTION_TYPE
  QUESTION_IDS
}

enum AttemptStatus {
  CREATED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  ABANDONED
}

enum SubmitReason {
  USER
  DEADLINE
  ADMIN
}

enum AnnotationKind {
  HIGHLIGHT
  NOTE
}

enum AnnotationTargetKind {
  PARAGRAPH
  QUESTION
  GROUP
}

enum WritingSubmissionStatus {
  DRAFT
  SUBMITTED
}

enum EvaluatorKind {
  LIBRARY
  LLM // reserved
  HUMAN
}

enum EvaluationStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum StorageDriver {
  LOCAL
  S3 // reserved for an S3-compatible driver
}

/// Drives read access: TEST_* → admin or students of an accessible test; SPEAKING_RECORDING → owner + admin; OCR_* → admin.
enum FilePurpose {
  TEST_AUDIO
  TEST_IMAGE
  SPEAKING_RECORDING
  OCR_SOURCE
  OCR_PAGE
}

enum OcrJobStatus {
  QUEUED
  RUNNING
  NEEDS_REVIEW
  FAILED
  IMPORTED
}

enum OcrMethod {
  PDF_TEXT
  TESSERACT
  MIXED
}

enum BandTableKind {
  LISTENING
  READING_ACADEMIC
  READING_GENERAL
}

enum VocabState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum OcrPageReview {
  PENDING
  APPROVED
}

// ───────── AUTH ─────────

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique /// lower-cased by the service
  displayName  String
  passwordHash String /// argon2id — globally omitted; only auth services opt in
  role         Role      @default(STUDENT)
  isActive     Boolean   @default(true) /// users are never deleted, only deactivated
  targetBand   Float?
  examDate     DateTime? @db.Date
  preferences  Json      @default("{}") /// UserPreferences (Zod)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  refreshTokens       RefreshToken[]
  createdTests        Test[]               @relation("TestCreatedBy")
  publishedTests      Test[]               @relation("TestPublishedBy")
  attempts            Attempt[]
  uploadedFiles       StoredFile[]
  bandTables          BandTable[]
  ocrJobs             OcrJob[]
  writingSubmissions  WritingSubmission[]
  writingReviews      WritingEvaluation[]  @relation("WritingEvaluationReviewer")
  speakingRecordings  SpeakingRecording[]
  speakingEvaluations SpeakingEvaluation[] @relation("SpeakingEvaluationReviewer")
  vocabularies        Vocabulary[]
  studyStats          StudyStat[]
  testMarks           UserTestMark[]

  @@index([role, isActive])
}

/// Opaque refresh token (32 random bytes) rotated on every refresh; only its sha256 is stored.
/// A rotated token is accepted again within REFRESH_ROTATION_GRACE_SECONDS (multi-tab race); no reuse detection.
model RefreshToken {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @db.Uuid
  familyId        String    @db.Uuid /// one login = one family
  tokenHash       String    @unique
  expiresAt       DateTime  @db.Timestamptz(3) /// sliding
  familyExpiresAt DateTime  @db.Timestamptz(3) /// absolute, from login
  persistent      Boolean   @default(false) /// "Ghi nhớ" ticked → cookies get Max-Age, else session cookies
  rotatedAt       DateTime? @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ───────── FILES ─────────

model StoredFile {
  id           String        @id @default(uuid(7)) @db.Uuid
  driver       StorageDriver @default(LOCAL)
  storageKey   String        @unique /// server-generated, never the client file name
  purpose      FilePurpose
  mimeType     String /// detected from magic bytes / generated by the server
  originalName String?
  sizeBytes    Int
  sha256       String
  widthPx      Int?
  heightPx     Int?
  durationMs   Int?
  uploadedById String?       @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  uploadedBy          User?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  audios              Audio[]
  paragraphImages     Paragraph[]
  writingTaskImages   WritingTask[]
  questionGroupImages QuestionGroup[]
  ocrSources          OcrJobSource[]
  ocrPages            OcrPage[]
  speakingRecordings  SpeakingRecording[]

  @@index([sha256, purpose])
  @@index([purpose, createdAt])
  @@index([uploadedById])
}

// ───────── TEST CONTENT ─────────

/// One row = one immutable VERSION of a test. Logical test = seriesKey.
model Test {
  id                 String     @id @default(uuid(7)) @db.Uuid
  seriesKey          String /// stable slug across versions, e.g. "cam18-t2-ac"
  version            Int        @default(1)
  status             TestStatus @default(DRAFT)
  publishedSeriesKey String?    @unique /// = seriesKey iff PUBLISHED → at most one published version per series
  source             TestSource
  type               TestType   @default(ACADEMIC)
  title              String
  sourceRef          String? /// e.g. "Cambridge IELTS 18 – Test 2" (metadata only, never content)
  bookNumber         Int?
  testNumber         Int?
  description        String?
  contentHash        String? /// sha256 of the canonical import document
  bandTableId        String?    @db.Uuid /// optional per-test override of the active band table
  publishedAt        DateTime?  @db.Timestamptz(3)
  createdById        String?    @db.Uuid
  publishedById      String?    @db.Uuid
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  createdBy    User?        @relation("TestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy  User?        @relation("TestPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  bandTable    BandTable?   @relation(fields: [bandTableId], references: [id], onDelete: Restrict)
  sections     Section[]
  attempts     Attempt[]
  ocrJobs      OcrJob[]
  vocabularies Vocabulary[]

  @@unique([seriesKey, version])
  @@index([status, source, bookNumber, testNumber])
  @@index([seriesKey, status])
  @@index([contentHash])
  @@index([bandTableId])
  @@index([createdById])
  @@index([publishedById])
  @@index([createdAt])
}

model Section {
  id           String   @id @default(uuid(7)) @db.Uuid
  testId       String   @db.Uuid
  skill        Skill
  durationSec  Int /// nominal EXAM limit; Listening = audio total + LISTENING_REVIEW_SEC
  instructions String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  parts     Part[]
  questions Question[]
  attempts  Attempt[]

  @@unique([testId, skill])
  @@index([skill])
}

/// Passage 1–3 | Listening Part 1–4 | Writing Task 1–2 | Speaking Part 1–3
model Part {
  id               String   @id @default(uuid(7)) @db.Uuid
  sectionId        String   @db.Uuid
  number           Int
  title            String?
  instructions     String? /// exam instruction strip
  suggestedMinutes Int? /// result screen "time vs recommended"
  durationSec      Int? /// EXAM limit when this part is taken alone
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  section            Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  passage            Passage?
  audio              Audio?
  writingTask        WritingTask?
  speakingPart       SpeakingPart?
  groups             QuestionGroup[]
  scopedAttempts     Attempt[]
  attemptParts       AttemptPart[]
  writingSubmissions WritingSubmission[]
  speakingRecordings SpeakingRecording[]

  @@unique([sectionId, number])
}

model Passage {
  id        String   @id @default(uuid(7)) @db.Uuid
  partId    String   @unique @db.Uuid
  title     String
  subtitle  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  part       Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  paragraphs Paragraph[]
}

model Paragraph {
  id        String        @id @default(uuid(7)) @db.Uuid
  passageId String        @db.Uuid
  order     Int
  label     String? /// "A","B",… (null = unlabeled)
  kind      ParagraphKind @default(BODY)
  text      String /// NORMALIZED text — annotation offsets refer to this exact string
  imageId   String?       @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  passage      Passage      @relation(fields: [passageId], references: [id], onDelete: Cascade)
  image        StoredFile?  @relation(fields: [imageId], references: [id], onDelete: Restrict)
  annotations  Annotation[]
  vocabularies Vocabulary[]

  @@unique([passageId, order])
  @@unique([passageId, label])
  @@index([imageId])
}

model Audio {
  id         String   @id @default(uuid(7)) @db.Uuid
  partId     String   @unique @db.Uuid
  fileId     String   @db.Uuid
  durationMs Int /// drives Listening timing
  startMs    Int? /// when several parts share one file
  endMs      Int?
  transcript String? /// NEVER sent before submit
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  part Part       @relation(fields: [partId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([fileId])
}

model WritingTask {
  id        String          @id @default(uuid(7)) @db.Uuid
  partId    String          @unique @db.Uuid /// Part.number = task 1|2
  kind      WritingTaskKind
  prompt    String
  imageId   String?         @db.Uuid /// Task 1 chart/map/process
  visual    String? /// Task 1: LINE|BAR|PIE|TABLE|MAP|PROCESS|MIXED (Zod enum)
  minWords  Int /// 150 | 250
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  part  Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  image StoredFile? @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@index([imageId])
}

model SpeakingPart {
  id           String   @id @default(uuid(7)) @db.Uuid
  partId       String   @unique @db.Uuid /// Part.number = 1|2|3
  topic        String?
  questions    String[] @default([])
  cueCard      Json? /// SpeakingCueCard (Zod) — Part 2
  prepSeconds  Int      @default(0) /// Part 2: 60
  speakSeconds Int? /// Part 2: 120
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model QuestionGroup {
  id           String       @id @default(uuid(7)) @db.Uuid
  partId       String       @db.Uuid
  order        Int
  type         QuestionType
  instructions String /// normalized, highlightable
  questionFrom Int
  questionTo   Int
  config       Json /// QuestionGroupConfig (Zod discriminated union on `type`) — contains NO answers
  imageId      String?      @db.Uuid /// map/diagram/flow-chart image
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  part        Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  image       StoredFile?  @relation(fields: [imageId], references: [id], onDelete: Restrict)
  questions   Question[]
  annotations Annotation[]

  @@unique([partId, order])
  @@index([type])
  @@index([imageId])
}

model Question {
  id              String   @id @default(uuid(7)) @db.Uuid
  groupId         String   @db.Uuid
  sectionId       String   @db.Uuid /// denormalized → unique numbering 1..40 per section
  number          Int
  prompt          String? /// may contain {{n}} blank markers
  content         Json     @default("{}") /// per-question data WITHOUT answers
  correctAnswer   Json /// CorrectAnswer (Zod)
  acceptedAnswers String[] @default([]) /// TEXT variants, e.g. ["colour","color"]
  wordLimit       Int?
  explanation     String?
  evidence        Json? /// {paragraphId,start,end,exact}
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  group       QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  section     Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers     Answer[]
  annotations Annotation[]

  @@unique([sectionId, number])
  @@index([groupId])
}

/// Raw→band reference tables (editable by admin). Rows are immutable; editing creates a new version.
model BandTable {
  id          String         @id @default(uuid(7)) @db.Uuid
  kind        BandTableKind
  version     Int
  activeKind  BandTableKind? @unique /// = kind iff this version is active → one active table per kind
  name        String
  rows        Json /// [{minRaw,maxRaw,band}] covering 0..40
  rowsHash    String
  note        String
  isReference Boolean        @default(true)
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tests     Test[]
  attempts  Attempt[]

  @@unique([kind, version])
  @@index([createdById])
}

// ───────── ATTEMPTS (tables created in P1, used from P3) ─────────

/// One attempt = one SKILL (Section) of one test version.
model Attempt {
  id                    String         @id @default(uuid(7)) @db.Uuid
  userId                String         @db.Uuid
  testId                String         @db.Uuid
  sectionId             String         @db.Uuid
  mode                  AttemptMode
  scope                 AttemptScope
  partId                String?        @db.Uuid /// scope = PART
  questionTypes         QuestionType[] @default([]) /// scope = QUESTION_TYPE
  questionNumbers       Int[]          @default([]) /// scope = QUESTION_IDS
  sourceAttemptId       String?        @db.Uuid /// scope = QUESTION_IDS
  scopeKey              String /// "SECTION" | "PART:<id>" | "QT:<A,B>" | "QN:<1,5>" (sorted)
  activeScopeKey        String? /// = scopeKey iff CREATED|IN_PROGRESS → one open attempt per scope
  isPreview             Boolean        @default(false) /// admin trying a DRAFT test; excluded from stats
  status                AttemptStatus  @default(CREATED)
  settings              Json           @default("{}")
  startedAt             DateTime?      @db.Timestamptz(3) /// set by POST /begin (server clock)
  timeLimitSec          Int?
  deadlineAt            DateTime?      @db.Timestamptz(3)
  submittedAt           DateTime?      @db.Timestamptz(3)
  submitReason          SubmitReason?
  lastClientSeq         Int            @default(0)
  lastSavedAt           DateTime?      @db.Timestamptz(3)
  currentQuestionNumber Int?
  uiState               Json           @default("{}")
  rawScore              Int?
  maxScore              Int?
  band                  Float?
  bandTableId           String?        @db.Uuid
  scoringVersion        String?
  scoredAt              DateTime?      @db.Timestamptz(3)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  test                Test                 @relation(fields: [testId], references: [id], onDelete: Restrict)
  section             Section              @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  part                Part?                @relation(fields: [partId], references: [id], onDelete: Restrict)
  bandTable           BandTable?           @relation(fields: [bandTableId], references: [id], onDelete: Restrict)
  sourceAttempt       Attempt?             @relation("AttemptRetry", fields: [sourceAttemptId], references: [id], onDelete: SetNull)
  retries             Attempt[]            @relation("AttemptRetry")
  answers             Answer[]
  attemptParts        AttemptPart[]
  annotations         Annotation[]
  writingSubmissions  WritingSubmission[]
  speakingRecordings  SpeakingRecording[]
  speakingEvaluations SpeakingEvaluation[]
  vocabularies        Vocabulary[]

  @@unique([userId, sectionId, activeScopeKey])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([testId])
  @@index([sectionId])
  @@index([partId])
  @@index([bandTableId])
  @@index([sourceAttemptId])
  @@index([status, deadlineAt])
}

model AttemptPart {
  id          String   @id @default(uuid(7)) @db.Uuid
  attemptId   String   @db.Uuid
  partId      String   @db.Uuid
  timeSpentMs Int      @default(0)
  rawScore    Int?
  maxScore    Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  part    Part    @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([attemptId, partId])
  @@index([partId])
}

model Answer {
  id           String    @id @default(uuid(7)) @db.Uuid
  attemptId    String    @db.Uuid
  questionId   String    @db.Uuid
  value        Json? /// AnswerValue (Zod); null = cleared
  flagged      Boolean   @default(false)
  answeredAt   DateTime? @db.Timestamptz(3)
  isCorrect    Boolean?
  scoringNotes Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model Annotation {
  id              String               @id @default(uuid(7)) @db.Uuid
  attemptId       String               @db.Uuid
  clientId        String               @db.Uuid /// idempotent create
  kind            AnnotationKind
  targetKind      AnnotationTargetKind
  paragraphId     String?              @db.Uuid
  questionId      String?              @db.Uuid
  questionGroupId String?              @db.Uuid
  field           String? /// QUESTION/GROUP text path; NULL for PARAGRAPH
  startOffset     Int /// UTF-16 code units over the normalized target string
  endOffset       Int
  exact           String
  prefix          String               @default("")
  suffix          String               @default("")
  note            String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  attempt       Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  paragraph     Paragraph?     @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  question      Question?      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionGroup QuestionGroup? @relation(fields: [questionGroupId], references: [id], onDelete: Cascade)

  @@unique([attemptId, clientId])
  @@index([paragraphId])
  @@index([questionId])
  @@index([questionGroupId])
}

// ───────── OCR [P2] ─────────

/// One OCR import: 1 PDF or 1–30 images. Results NEVER go into test tables automatically (spec §6 P2).
model OcrJob {
  id             String       @id @default(uuid(7)) @db.Uuid
  createdById    String?      @db.Uuid
  title          String?
  status         OcrJobStatus @default(QUEUED)
  method         OcrMethod?
  language       String       @default("eng")
  progress       Float        @default(0) /// 0..1
  attempts       Int          @default(0)
  runAfter       DateTime     @default(now()) @db.Timestamptz(3) /// retry backoff
  pageCount      Int?
  rawText        String?
  meanConfidence Float?
  reviewDraft    Json? /// OcrReviewDraft (Zod) — edited in the review screen, saved as a whole
  draftVersion   Int          @default(0) /// optimistic concurrency for review saves
  lastError      String?
  startedAt      DateTime?    @db.Timestamptz(3)
  finishedAt     DateTime?    @db.Timestamptz(3)
  importedTestId String?      @db.Uuid /// DRAFT test created on publish
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  importedTest Test?          @relation(fields: [importedTestId], references: [id], onDelete: SetNull)
  sources      OcrJobSource[]
  pages        OcrPage[]

  @@index([status, runAfter])
  @@index([createdById, createdAt])
  @@index([importedTestId])
}

model OcrJobSource {
  id        String   @id @default(uuid(7)) @db.Uuid
  jobId     String   @db.Uuid
  fileId    String   @db.Uuid
  pageOrder Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  job  OcrJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([jobId, pageOrder])
  @@index([fileId])
}

/// One rasterized page shown on the left of the OCR review screen.
model OcrPage {
  id             String        @id @default(uuid(7)) @db.Uuid
  jobId          String        @db.Uuid
  pageNumber     Int
  imageFileId    String        @db.Uuid /// purpose OCR_PAGE
  widthPx        Int
  heightPx       Int
  rotation       Int           @default(0) /// 0|90|180|270
  method         OcrMethod
  meanConfidence Float?
  blocks         Json /// OcrBlock[] — raw engine output
  reviewStatus   OcrPageReview @default(PENDING)
  reviewedAt     DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  job       OcrJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  imageFile StoredFile @relation(fields: [imageFileId], references: [id], onDelete: Restrict)

  @@unique([jobId, pageNumber])
  @@index([imageFileId])
}

// ───────── WRITING [P5] ─────────

model WritingSubmission {
  id            String                  @id @default(uuid(7)) @db.Uuid
  attemptId     String                  @db.Uuid
  partId        String                  @db.Uuid /// → WritingTask
  userId        String                  @db.Uuid
  text          String                  @default("")
  wordCount     Int                     @default(0) /// recomputed server-side (shared countWords)
  status        WritingSubmissionStatus @default(DRAFT)
  lastClientSeq Int                     @default(0) /// per-task autosave CAS
  lastSavedAt   DateTime?               @db.Timestamptz(3)
  submittedAt   DateTime?               @db.Timestamptz(3)
  selfChecklist Json                    @default("{}") /// TR/CC self-tick checklist
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                @updatedAt @db.Timestamptz(3)

  attempt     Attempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  part        Part                @relation(fields: [partId], references: [id], onDelete: Restrict)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  evaluations WritingEvaluation[]

  @@unique([attemptId, partId])
  @@index([userId, createdAt])
  @@index([partId, userId])
}

/// Append-only: each run (LIBRARY, future LLM, HUMAN) is one row → history & compare.
model WritingEvaluation {
  id               String           @id @default(uuid(7)) @db.Uuid
  submissionId     String           @db.Uuid
  evaluator        EvaluatorKind
  evaluatorVersion String
  status           EvaluationStatus @default(PENDING)
  textHash         String
  language         String?
  isEstimate       Boolean          @default(true) /// false only for HUMAN
  bandTaskResponse Float?
  bandCoherence    Float?
  bandLexical      Float?
  bandGrammar      Float?
  bandOverall      Float?
  result           Json? /// WritingEvaluationResult (Zod)
  comment          String?
  reviewerId       String?          @db.Uuid
  error            String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  submission WritingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User?             @relation("WritingEvaluationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
  @@index([evaluator, status])
  @@index([reviewerId])
}

// ───────── SPEAKING [P5] ─────────

model SpeakingRecording {
  id            String   @id @default(uuid(7)) @db.Uuid
  attemptId     String   @db.Uuid
  partId        String   @db.Uuid
  userId        String   @db.Uuid
  questionIndex Int      @default(0)
  take          Int      @default(1)
  fileId        String   @db.Uuid
  durationMs    Int? /// client-declared, display only
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  attempt     Attempt              @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  part        Part                 @relation(fields: [partId], references: [id], onDelete: Restrict)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  file        StoredFile           @relation(fields: [fileId], references: [id], onDelete: Restrict)
  evaluations SpeakingEvaluation[]

  @@unique([attemptId, partId, questionIndex, take])
  @@index([userId, createdAt])
  @@index([partId])
  @@index([fileId])
}

/// Symmetric with WritingEvaluation so a future SpeakingEvaluator needs no schema change.
model SpeakingEvaluation {
  id                String           @id @default(uuid(7)) @db.Uuid
  attemptId         String           @db.Uuid
  recordingId       String?          @db.Uuid
  evaluator         EvaluatorKind    @default(HUMAN)
  evaluatorVersion  String?
  status            EvaluationStatus @default(DONE)
  isEstimate        Boolean          @default(false)
  bandFluency       Float?
  bandLexical       Float?
  bandGrammar       Float?
  bandPronunciation Float?
  bandOverall       Float?
  result            Json?
  comment           String?
  reviewerId        String?          @db.Uuid
  error             String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  attempt   Attempt            @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  recording SpeakingRecording? @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  reviewer  User?              @relation("SpeakingEvaluationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([attemptId, createdAt])
  @@index([recordingId])
  @@index([reviewerId])
}

// ───────── VOCABULARY / STATS [P6] ─────────

model Vocabulary {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @db.Uuid
  term              String
  normalizedTerm    String /// NFC, lower-cased, trimmed
  partOfSpeech      String?
  phonetic          String?
  meaning           String? /// Vietnamese meaning, typed by the student
  definition        String? /// English definition (dictionary lookup)
  notes             String?
  exampleSentence   String? /// from the source passage
  sourceTestId      String?    @db.Uuid
  sourceParagraphId String?    @db.Uuid
  sourceAttemptId   String?    @db.Uuid
  sourceStart       Int?
  sourceEnd         Int?
  tags              String[]   @default([])
  state             VocabState @default(NEW)
  learningStep      Int        @default(0)
  easeFactor        Float      @default(2.5) /// SM-2
  intervalDays      Int        @default(0)
  repetitions       Int        @default(0)
  lapses            Int        @default(0)
  dueAt             DateTime   @default(now()) @db.Timestamptz(3)
  lastReviewedAt    DateTime?  @db.Timestamptz(3)
  isSuspended       Boolean    @default(false)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceTest      Test?              @relation(fields: [sourceTestId], references: [id], onDelete: SetNull)
  sourceParagraph Paragraph?         @relation(fields: [sourceParagraphId], references: [id], onDelete: SetNull)
  sourceAttempt   Attempt?           @relation(fields: [sourceAttemptId], references: [id], onDelete: SetNull)
  reviews         VocabularyReview[]

  @@unique([userId, normalizedTerm])
  @@index([userId, dueAt])
  @@index([userId, createdAt])
  @@index([sourceTestId])
  @@index([sourceParagraphId])
  @@index([sourceAttemptId])
}

model VocabularyReview {
  id              String   @id @default(uuid(7)) @db.Uuid
  vocabularyId    String   @db.Uuid
  clientReviewId  String   @unique @db.Uuid /// idempotent POST
  grade           Int /// SM-2 quality: Lại=1, Khó=3, Được=4, Dễ=5
  reviewedAt      DateTime @default(now()) @db.Timestamptz(3)
  prevIntervalDay Int
  newIntervalDay  Int
  prevEaseFactor  Float
  newEaseFactor   Float
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([vocabularyId, reviewedAt])
}

/// Daily aggregates in APP_TIMEZONE, written only by the idempotent recomputeDay(userId, date).
model StudyStat {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @db.Uuid
  date              DateTime @db.Date
  activeSeconds     Int      @default(0)
  attemptsStarted   Int      @default(0)
  attemptsSubmitted Int      @default(0)
  questionsAnswered Int      @default(0)
  questionsCorrect  Int      @default(0)
  wordsWritten      Int      @default(0)
  speakingSeconds   Int      @default(0)
  vocabAdded        Int      @default(0)
  vocabReviewed     Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@index([date])
}

/// "Đánh dấu đã làm" / hide a test from suggestions (per logical test = seriesKey).
model UserTestMark {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  seriesKey String
  doneAt    DateTime? @db.Timestamptz(3)
  hidden    Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, seriesKey])
}

model DictionaryCache {
  id        String   @id @default(uuid(7)) @db.Uuid
  term      String /// normalized
  provider  String
  payload   Json
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([provider, term])
  @@index([expiresAt])
}
