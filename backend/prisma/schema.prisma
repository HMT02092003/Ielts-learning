// Prisma ORM 7.10.1 — connection URL lives in prisma.config.ts.
// Phase 1 schema. Later phases add models with additive migrations:
//   [P2] OcrJob, OcrJobSource, OcrPage · [P5] WritingSubmission, WritingEvaluation, SpeakingRecording, SpeakingEvaluation
//   [P6] Vocabulary, VocabularyReview, StudyStat, UserTestMark, DictionaryCache
// All enums (including values used only by later phases) are created now to avoid ALTER TYPE mid-project.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────── ENUMS ─────────

enum Role {
  ADMIN
  STUDENT
}

/// Display/filter priority is NOT the declaration order — use SOURCE_PRIORITY in src/shared.
enum TestSource {
  CAM
  VOL
  PRE_IELTS
  CUSTOM // self-written dummy/seed tests
}

enum TestType {
  ACADEMIC
  GENERAL
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED // superseded by a newer published version; still referenced by old attempts
}

enum Skill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum ParagraphKind {
  BODY
  HEADING
  SUBHEADING
  FIGURE
  FOOTNOTE
}

enum QuestionType {
  MULTIPLE_CHOICE_SINGLE
  MULTIPLE_CHOICE_MULTI
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING_HEADINGS
  MATCHING_INFORMATION
  MATCHING_FEATURES
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  NOTE_TABLE_FLOWCHART_COMPLETION
  SHORT_ANSWER
  MAP_DIAGRAM_LABELLING
}

enum WritingTaskKind {
  ACADEMIC_REPORT // AC Task 1
  GENERAL_LETTER // GT Task 1
  ESSAY // Task 2
}

enum AttemptMode {
  EXAM
  PRACTICE
}

/// QUESTION_TYPE / QUESTION_IDS are PRACTICE-only; QUESTION_IDS = "retry wrong answers".
enum AttemptScope {
  SECTION
  PART
  QUESTION_TYPE
  QUESTION_IDS
}

enum AttemptStatus {
  CREATED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  ABANDONED
}

enum SubmitReason {
  USER
  DEADLINE
  ADMIN
}

enum AnnotationKind {
  HIGHLIGHT
  NOTE
}

enum AnnotationTargetKind {
  PARAGRAPH
  QUESTION
  GROUP
}

enum WritingSubmissionStatus {
  DRAFT
  SUBMITTED
}

enum EvaluatorKind {
  LIBRARY
  LLM // reserved
  HUMAN
}

enum EvaluationStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum StorageDriver {
  LOCAL
  S3 // reserved for an S3-compatible driver
}

/// Drives read access: TEST_* → admin or students of an accessible test; SPEAKING_RECORDING → owner + admin; OCR_* → admin.
enum FilePurpose {
  TEST_AUDIO
  TEST_IMAGE
  SPEAKING_RECORDING
  OCR_SOURCE
  OCR_PAGE
}

enum OcrJobStatus {
  QUEUED
  RUNNING
  NEEDS_REVIEW
  FAILED
  IMPORTED
}

enum OcrMethod {
  PDF_TEXT
  TESSERACT
  MIXED
}

enum BandTableKind {
  LISTENING
  READING_ACADEMIC
  READING_GENERAL
}

enum VocabState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum OcrPageReview {
  PENDING
  APPROVED
}

// ───────── AUTH ─────────

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique /// lower-cased by the service
  displayName  String
  passwordHash String /// argon2id — globally omitted; only auth services opt in
  role         Role      @default(STUDENT)
  isActive     Boolean   @default(true) /// users are never deleted, only deactivated
  targetBand   Float?
  examDate     DateTime? @db.Date
  preferences  Json      @default("{}") /// UserPreferences (Zod)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  refreshTokens  RefreshToken[]
  createdTests   Test[]         @relation("TestCreatedBy")
  publishedTests Test[]         @relation("TestPublishedBy")
  attempts       Attempt[]
  uploadedFiles  StoredFile[]
  bandTables     BandTable[]

  @@index([role, isActive])
}

/// Opaque refresh token (32 random bytes) rotated on every refresh; only its sha256 is stored.
/// A rotated token is accepted again within REFRESH_ROTATION_GRACE_SECONDS (multi-tab race); no reuse detection.
model RefreshToken {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @db.Uuid
  familyId        String    @db.Uuid /// one login = one family
  tokenHash       String    @unique
  expiresAt       DateTime  @db.Timestamptz(3) /// sliding
  familyExpiresAt DateTime  @db.Timestamptz(3) /// absolute, from login
  persistent      Boolean   @default(false) /// "Ghi nhớ" ticked → cookies get Max-Age, else session cookies
  rotatedAt       DateTime? @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ───────── FILES ─────────

model StoredFile {
  id           String        @id @default(uuid(7)) @db.Uuid
  driver       StorageDriver @default(LOCAL)
  storageKey   String        @unique /// server-generated, never the client file name
  purpose      FilePurpose
  mimeType     String /// detected from magic bytes / generated by the server
  originalName String?
  sizeBytes    Int
  sha256       String
  widthPx      Int?
  heightPx     Int?
  durationMs   Int?
  uploadedById String?       @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  uploadedBy          User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  audios              Audio[]
  paragraphImages     Paragraph[]
  writingTaskImages   WritingTask[]
  questionGroupImages QuestionGroup[]

  @@index([sha256, purpose])
  @@index([purpose, createdAt])
  @@index([uploadedById])
}

// ───────── TEST CONTENT ─────────

/// One row = one immutable VERSION of a test. Logical test = seriesKey.
model Test {
  id                 String     @id @default(uuid(7)) @db.Uuid
  seriesKey          String /// stable slug across versions, e.g. "cam18-t2-ac"
  version            Int        @default(1)
  status             TestStatus @default(DRAFT)
  publishedSeriesKey String?    @unique /// = seriesKey iff PUBLISHED → at most one published version per series
  source             TestSource
  type               TestType   @default(ACADEMIC)
  title              String
  sourceRef          String? /// e.g. "Cambridge IELTS 18 – Test 2" (metadata only, never content)
  bookNumber         Int?
  testNumber         Int?
  description        String?
  contentHash        String? /// sha256 of the canonical import document
  bandTableId        String?    @db.Uuid /// optional per-test override of the active band table
  publishedAt        DateTime?  @db.Timestamptz(3)
  createdById        String?    @db.Uuid
  publishedById      String?    @db.Uuid
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  createdBy   User?      @relation("TestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy User?      @relation("TestPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  bandTable   BandTable? @relation(fields: [bandTableId], references: [id], onDelete: Restrict)
  sections    Section[]
  attempts    Attempt[]

  @@unique([seriesKey, version])
  @@index([status, source, bookNumber, testNumber])
  @@index([seriesKey, status])
  @@index([contentHash])
  @@index([bandTableId])
  @@index([createdById])
  @@index([publishedById])
  @@index([createdAt])
}

model Section {
  id           String   @id @default(uuid(7)) @db.Uuid
  testId       String   @db.Uuid
  skill        Skill
  durationSec  Int /// nominal EXAM limit; Listening = audio total + LISTENING_REVIEW_SEC
  instructions String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  parts     Part[]
  questions Question[]
  attempts  Attempt[]

  @@unique([testId, skill])
  @@index([skill])
}

/// Passage 1–3 | Listening Part 1–4 | Writing Task 1–2 | Speaking Part 1–3
model Part {
  id               String   @id @default(uuid(7)) @db.Uuid
  sectionId        String   @db.Uuid
  number           Int
  title            String?
  instructions     String? /// exam instruction strip
  suggestedMinutes Int? /// result screen "time vs recommended"
  durationSec      Int? /// EXAM limit when this part is taken alone
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  passage        Passage?
  audio          Audio?
  writingTask    WritingTask?
  speakingPart   SpeakingPart?
  groups         QuestionGroup[]
  scopedAttempts Attempt[]
  attemptParts   AttemptPart[]

  @@unique([sectionId, number])
}

model Passage {
  id        String   @id @default(uuid(7)) @db.Uuid
  partId    String   @unique @db.Uuid
  title     String
  subtitle  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  part       Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  paragraphs Paragraph[]
}

model Paragraph {
  id        String        @id @default(uuid(7)) @db.Uuid
  passageId String        @db.Uuid
  order     Int
  label     String? /// "A","B",… (null = unlabeled)
  kind      ParagraphKind @default(BODY)
  text      String /// NORMALIZED text — annotation offsets refer to this exact string
  imageId   String?       @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  passage     Passage      @relation(fields: [passageId], references: [id], onDelete: Cascade)
  image       StoredFile?  @relation(fields: [imageId], references: [id], onDelete: Restrict)
  annotations Annotation[]

  @@unique([passageId, order])
  @@unique([passageId, label])
  @@index([imageId])
}

model Audio {
  id         String   @id @default(uuid(7)) @db.Uuid
  partId     String   @unique @db.Uuid
  fileId     String   @db.Uuid
  durationMs Int /// drives Listening timing
  startMs    Int? /// when several parts share one file
  endMs      Int?
  transcript String? /// NEVER sent before submit
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  part Part       @relation(fields: [partId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([fileId])
}

model WritingTask {
  id        String          @id @default(uuid(7)) @db.Uuid
  partId    String          @unique @db.Uuid /// Part.number = task 1|2
  kind      WritingTaskKind
  prompt    String
  imageId   String?         @db.Uuid /// Task 1 chart/map/process
  visual    String? /// Task 1: LINE|BAR|PIE|TABLE|MAP|PROCESS|MIXED (Zod enum)
  minWords  Int /// 150 | 250
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  part  Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  image StoredFile? @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@index([imageId])
}

model SpeakingPart {
  id           String   @id @default(uuid(7)) @db.Uuid
  partId       String   @unique @db.Uuid /// Part.number = 1|2|3
  topic        String?
  questions    String[] @default([])
  cueCard      Json? /// SpeakingCueCard (Zod) — Part 2
  prepSeconds  Int      @default(0) /// Part 2: 60
  speakSeconds Int? /// Part 2: 120
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model QuestionGroup {
  id           String       @id @default(uuid(7)) @db.Uuid
  partId       String       @db.Uuid
  order        Int
  type         QuestionType
  instructions String /// normalized, highlightable
  questionFrom Int
  questionTo   Int
  config       Json /// QuestionGroupConfig (Zod discriminated union on `type`) — contains NO answers
  imageId      String?      @db.Uuid /// map/diagram/flow-chart image
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  part        Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  image       StoredFile?  @relation(fields: [imageId], references: [id], onDelete: Restrict)
  questions   Question[]
  annotations Annotation[]

  @@unique([partId, order])
  @@index([type])
  @@index([imageId])
}

model Question {
  id              String   @id @default(uuid(7)) @db.Uuid
  groupId         String   @db.Uuid
  sectionId       String   @db.Uuid /// denormalized → unique numbering 1..40 per section
  number          Int
  prompt          String? /// may contain {{n}} blank markers
  content         Json     @default("{}") /// per-question data WITHOUT answers
  correctAnswer   Json /// CorrectAnswer (Zod)
  acceptedAnswers String[] @default([]) /// TEXT variants, e.g. ["colour","color"]
  wordLimit       Int?
  explanation     String?
  evidence        Json? /// {paragraphId,start,end,exact}
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  group       QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  section     Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers     Answer[]
  annotations Annotation[]

  @@unique([sectionId, number])
  @@index([groupId])
}

/// Raw→band reference tables (editable by admin). Rows are immutable; editing creates a new version.
model BandTable {
  id          String         @id @default(uuid(7)) @db.Uuid
  kind        BandTableKind
  version     Int
  activeKind  BandTableKind? @unique /// = kind iff this version is active → one active table per kind
  name        String
  rows        Json /// [{minRaw,maxRaw,band}] covering 0..40
  rowsHash    String
  note        String
  isReference Boolean        @default(true)
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tests     Test[]
  attempts  Attempt[]

  @@unique([kind, version])
  @@index([createdById])
}

// ───────── ATTEMPTS (tables created in P1, used from P3) ─────────

/// One attempt = one SKILL (Section) of one test version.
model Attempt {
  id                    String         @id @default(uuid(7)) @db.Uuid
  userId                String         @db.Uuid
  testId                String         @db.Uuid
  sectionId             String         @db.Uuid
  mode                  AttemptMode
  scope                 AttemptScope
  partId                String?        @db.Uuid /// scope = PART
  questionTypes         QuestionType[] @default([]) /// scope = QUESTION_TYPE
  questionNumbers       Int[]          @default([]) /// scope = QUESTION_IDS
  sourceAttemptId       String?        @db.Uuid /// scope = QUESTION_IDS
  scopeKey              String /// "SECTION" | "PART:<id>" | "QT:<A,B>" | "QN:<1,5>" (sorted)
  activeScopeKey        String? /// = scopeKey iff CREATED|IN_PROGRESS → one open attempt per scope
  isPreview             Boolean        @default(false) /// admin trying a DRAFT test; excluded from stats
  status                AttemptStatus  @default(CREATED)
  settings              Json           @default("{}")
  startedAt             DateTime?      @db.Timestamptz(3) /// set by POST /begin (server clock)
  timeLimitSec          Int?
  deadlineAt            DateTime?      @db.Timestamptz(3)
  submittedAt           DateTime?      @db.Timestamptz(3)
  submitReason          SubmitReason?
  lastClientSeq         Int            @default(0)
  lastSavedAt           DateTime?      @db.Timestamptz(3)
  currentQuestionNumber Int?
  uiState               Json           @default("{}")
  rawScore              Int?
  maxScore              Int?
  band                  Float?
  bandTableId           String?        @db.Uuid
  scoringVersion        String?
  scoredAt              DateTime?      @db.Timestamptz(3)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  test          Test          @relation(fields: [testId], references: [id], onDelete: Restrict)
  section       Section       @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  part          Part?         @relation(fields: [partId], references: [id], onDelete: Restrict)
  bandTable     BandTable?    @relation(fields: [bandTableId], references: [id], onDelete: Restrict)
  sourceAttempt Attempt?      @relation("AttemptRetry", fields: [sourceAttemptId], references: [id], onDelete: SetNull)
  retries       Attempt[]     @relation("AttemptRetry")
  answers       Answer[]
  attemptParts  AttemptPart[]
  annotations   Annotation[]

  @@unique([userId, sectionId, activeScopeKey])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([testId])
  @@index([sectionId])
  @@index([partId])
  @@index([bandTableId])
  @@index([sourceAttemptId])
  @@index([status, deadlineAt])
}

model AttemptPart {
  id          String   @id @default(uuid(7)) @db.Uuid
  attemptId   String   @db.Uuid
  partId      String   @db.Uuid
  timeSpentMs Int      @default(0)
  rawScore    Int?
  maxScore    Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  part    Part    @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([attemptId, partId])
  @@index([partId])
}

model Answer {
  id           String    @id @default(uuid(7)) @db.Uuid
  attemptId    String    @db.Uuid
  questionId   String    @db.Uuid
  value        Json? /// AnswerValue (Zod); null = cleared
  flagged      Boolean   @default(false)
  answeredAt   DateTime? @db.Timestamptz(3)
  isCorrect    Boolean?
  scoringNotes Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model Annotation {
  id              String               @id @default(uuid(7)) @db.Uuid
  attemptId       String               @db.Uuid
  clientId        String               @db.Uuid /// idempotent create
  kind            AnnotationKind
  targetKind      AnnotationTargetKind
  paragraphId     String?              @db.Uuid
  questionId      String?              @db.Uuid
  questionGroupId String?              @db.Uuid
  field           String? /// QUESTION/GROUP text path; NULL for PARAGRAPH
  startOffset     Int /// UTF-16 code units over the normalized target string
  endOffset       Int
  exact           String
  prefix          String               @default("")
  suffix          String               @default("")
  note            String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  attempt       Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  paragraph     Paragraph?     @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  question      Question?      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionGroup QuestionGroup? @relation(fields: [questionGroupId], references: [id], onDelete: Cascade)

  @@unique([attemptId, clientId])
  @@index([paragraphId])
  @@index([questionId])
  @@index([questionGroupId])
}
