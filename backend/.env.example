# â”€â”€ Runtime â”€â”€
NODE_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh
API_HOST=127.0.0.1
API_PORT=40000
# Browser origin of the Next.js app (origin guard / CORS allowlist)
WEB_ORIGIN=http://localhost:30000,http://localhost:31000
LOG_LEVEL=info

# â”€â”€ Database (docker compose publishes Postgres on 127.0.0.1:5434) â”€â”€
DATABASE_URL=postgresql://ielts:ielts_dev_password@127.0.0.1:5432/ielts
# Test databases: names MUST end with _test (guarded)
TEST_DATABASE_URL=postgresql://ielts:ielts_dev_password@127.0.0.1:5432/ielts_test
E2E_DATABASE_URL=postgresql://ielts:ielts_dev_password@127.0.0.1:5432/ielts_e2e_test

# â”€â”€ Auth â”€â”€
# >= 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
JWT_ISSUER=ielts-api
JWT_AUDIENCE=ielts-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_FAMILY_MAX_DAYS=90
REFRESH_ROTATION_GRACE_SECONDS=30
COOKIE_SECURE=false
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
PASSWORD_MIN_LENGTH=8

# â”€â”€ Rate limits â”€â”€
RATE_LIMIT_GLOBAL_PER_MIN=600

# â”€â”€ Seed accounts (used by `yarn run db:seed`) â”€â”€
SEED_ADMIN_EMAIL=admin@ielts.local
SEED_ADMIN_PASSWORD=123456789
SEED_ADMIN_NAME=Quáº£n trá»‹ viÃªn
SEED_STUDENT_EMAIL=dat@ielts.local
SEED_STUDENT_PASSWORD=123456789
SEED_STUDENT_NAME=Äáº¡t
SEED_ADMIN_RESET_PASSWORD=false

# â”€â”€ Storage (relative paths resolve from backend/) â”€â”€
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../data/storage
UPLOAD_TMP_DIR=../data/tmp

# â”€â”€ LanguageTool (Phase 5; health check from Phase 1) â”€â”€
LANGUAGETOOL_URL=http://127.0.0.1:8010
LANGUAGETOOL_LANG=en-GB
LANGUAGETOOL_TIMEOUT_MS=8000

# Dictionary lookup (Free Dictionary API, cached in the DB)
DICTIONARY_URL=https://api.dictionaryapi.dev/api/v2/entries/en
DICTIONARY_CACHE_DAYS=30
DICTIONARY_TIMEOUT_MS=4000
